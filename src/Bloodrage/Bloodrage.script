// Bloodrage Theme - Cleaned & Centered
state = "normal";

// ============ Utils
Object.set_image = fun(image) {
    this.sprite.SetImage(image);
    this.w = image.GetWidth();
    this.h = image.GetHeight();
};

Object.put = fun(x,y) {
    this.x = x;
    this.y = y;
    this.sprite.SetPosition(x, y);
};

Object.below = fun(other, margin) {
    if (margin == null) margin = 0;
    this.y = other.y + other.h + margin;
    this.sprite.SetY(this.y);
};

// Fungsi tengahkan objek terhadap layar secara horizontal
Object.center_horizontally = fun() {
    this.x = (Window.GetWidth() / 2) - (this.w / 2);
    this.sprite.SetX(this.x);
};

Object |= fun(image) {
    object = [] | global.Object;
    object.sprite = Sprite(image);
    object.w = image.GetWidth();
    object.h = image.GetHeight();
    object.put(0, 0);
    return object;
};

// Object Manager
objstore.store = [];
objstore.mark = 0;
objstore.add = fun (p) {
    for (i = 0; i <= this.mark+1; i++) {
        if (!this.store[i]) {
            this.store[i] = p;
            this.mark = Math.Max(this.mark, i);
            break;
        }
    }
};
objstore.update = fun() {
    for (i = 0; i < this.mark+1; i++) {
        if (this.store[i] && !this.store[i].dead) {
            this.store[i].update();
        }
    }
};

fun whitetext(text, size) {
    return Image.Text(text, 0.7, 0.1, 0.1, 1, "monospace " + size);
}

// ========== Fungsi Label (Ditaruh di atas agar bisa dipanggil)
fun get_status_text() {
    mode = Plymouth.GetMode();
    if (mode == "boot") return "Loading NixOS...";
    if (mode == "shutdown") return "Shutting Down...";
    if (mode == "reboot") return "Reboot initiated...";
    if (mode == "updates") return "System Update in progress...";
    return "processing...";
}

// ========== Animated logo
NUMBER_OF_FRAMES = 60;
logo = Object(Image("0.png"));
for (i = 0; i < NUMBER_OF_FRAMES; i++) { logo.frames[i] = Image(i + ".png"); }

// PENGATUR KECEPATAN (Slow down)
logo.frame = 0;
logo.counter = 0;
logo.speed_divider = 2; // NAIKKAN angka ini jika masih terlalu cepat (misal: 4 atau 5)

logo.update = fun () {
    this.counter++;
    if (this.counter >= this.speed_divider) {
        this.counter = 0;
        this.frame = (this.frame + 1) % NUMBER_OF_FRAMES;
        this.set_image(this.frames[this.frame]);
    }
    // Pastikan selalu di tengah meski resolusi berubah
    this.put(Window.GetWidth()/2 - this.w/2, Window.GetHeight()/2 - this.h/2 - 80);
};
objstore.add(logo);

// ========== Welcome Message
welcome_msg = Object(whitetext("Welcome to Bloodrage", 35));
welcome_msg.update = fun() {
    this.below(global.logo, 40);
    this.center_horizontally();
};
objstore.add(welcome_msg);

// ========== Status Label
status_label = Object(whitetext(get_status_text(), 15));
status_label.update = fun() {
    this.below(global.welcome_msg, 15);
    this.center_horizontally();
};
objstore.add(status_label);

// ========== Background & Callbacks
Window.SetBackgroundTopColor (0, 0, 0);
Window.SetBackgroundBottomColor (0, 0, 0);

fun refresh_loop() {
    objstore.update();
}  
Plymouth.SetRefreshFunction(refresh_loop);

// (Opsional) Matikan debug counter "2" dengan tidak memanggil objcounter
